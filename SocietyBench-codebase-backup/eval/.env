# =============================================================================
# SocietyBench — configuration template
# Copy to .env and fill in your own credentials. All variables are read via os.environ / os.getenv.
# =============================================================================

# ---- Unified aggregator API for evaluation (required) -----------------------
# We use one OpenAI-compatible aggregator API to dispatch all evaluated models
# (any OpenAI-compatible endpoint works: GPT / Gemini / Claude / Doubao, etc.)
DMXAPI_KEY=
DMXAPI_BASE_URL=https://your-api-endpoint.example.com/v1/chat/completions

# ---- Web collection (only needed when collecting from scratch) --------------
APIFY_TOKEN=

# ---- Social-media collection (only needed when collecting social media) -----
MCP_HOME=                          # MediaCrawlerPro-Python install path
MCP_SIGNSRV_URL=                   # SignSrv service URL
